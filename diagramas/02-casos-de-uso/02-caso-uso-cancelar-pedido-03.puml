@startuml 02-caso-uso-cancelar-pedido-03
top to bottom direction
skinparam dpi 150
skinparam nodesep 45
skinparam ranksep 60
skinparam linetype polyline
skinparam ArrowFontSize 11
hide empty members
actor Cliente
actor "Usuario de Mostrador" as Mostrador
actor "Encargado" as Encargado

Cliente .. Mostrador : solicita la cancelacion

rectangle "Sistema de Pedidos" {
	usecase "Cancelar Pedido" as Cancelar
	usecase "Buscar pedido por identificador/referencia" as Buscar
	usecase "Validar estado del pedido" as ValidarEstado
	usecase "Solicitar y registrar motivo de cancelacion" as RegistrarMotivo
	usecase "Procesar reembolso/devolucion" as Reembolsar
	usecase "Confirmar cancelacion y liberar comanda" as Confirmar
	usecase "Autorizar cancelacion en preparacion" as Autorizar
	note right of Autorizar
		Solo EN_PREPARACION: UsuarioEncargado
		autoriza antes de confirmar.
		Si deniega, no se cancela el pedido.
	end note
	usecase "Bloquear cancelacion (LISTO/ENTREGADO)" as Bloquear
	usecase "Resolver rechazo de reembolso" as RechazoReembolso
}

Mostrador -- Cancelar
Encargado -- Autorizar

' El actor Encargado corresponde a la clase UsuarioEncargado
' del boceto (autorizarCancelacion()).
Cancelar .> Buscar : <<include>>
Cancelar .> ValidarEstado : <<include>>
Cancelar .> RegistrarMotivo : <<include>>
Cancelar .> Reembolsar : <<include>>
Cancelar .> Confirmar : <<include>>

Autorizar .> Cancelar : <<extend>> [EN_PREPARACION]
Bloquear .> ValidarEstado : <<extend>>
RechazoReembolso .> Reembolsar : <<extend>>

' --- Control de ranks: caso base arriba, incluidos en fila propia debajo ---
Cancelar -[hidden]down- Buscar
Cancelar -[hidden]down- ValidarEstado
Cancelar -[hidden]down- RegistrarMotivo
Cancelar -[hidden]down- Reembolsar
Cancelar -[hidden]down- Confirmar
Buscar -[hidden]right- ValidarEstado
ValidarEstado -[hidden]right- RegistrarMotivo
RegistrarMotivo -[hidden]right- Reembolsar
Reembolsar -[hidden]right- Confirmar
Autorizar -[hidden]down- Cancelar
Bloquear -[hidden]down- ValidarEstado
RechazoReembolso -[hidden]down- Reembolsar
Encargado -[hidden]down- Autorizar
@enduml