@startuml CU01_Crear_Pedido
left to right direction

actor Cliente
actor "Usuario de Mostrador" as Mostrador
actor "Personal de Cocina" as Cocina

rectangle "Sistema de Pedidos" {
    usecase "Crear Pedido" as Crear
    usecase "Identificar pedido y referencia" as Identificar
    usecase "Seleccionar productos o combos" as Seleccionar
    usecase "Agregar personalizaciones" as Personalizar
    usecase "Calcular total" as Calcular
    usecase "Registrar pago" as RegistrarPago
    usecase "Confirmar y enviar a cocina" as Confirmar
    usecase "Cancelar carga antes del pago" as CancelarCarga
    usecase "Resolver falta de stock" as FaltaStock
    usecase "Rechazar transferencia" as RechazoTransferencia
}

Cliente -- Crear
Mostrador -- Crear
Cocina -- Confirmar

Crear .> Identificar : <<include>>
Crear .> Seleccionar : <<include>>
Crear .> Personalizar : <<include>>
Crear .> Calcular : <<include>>
Crear .> RegistrarPago : <<include>>
Crear .> Confirmar : <<include>>

CancelarCarga .> Crear : <<extend>>
FaltaStock .> Seleccionar : <<extend>>
RechazoTransferencia .> RegistrarPago : <<extend>>
@enduml