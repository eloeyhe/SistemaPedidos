@startuml
title Tomar pedido - registro exitoso o rechazo del pago
autonumber
skinparam style strictuml
hide footbox

actor "Usuario de Mostrador" as mostrador
participant "SistemaPedidos:sistema" as sistema
participant "Producto:producto" as producto
participant "Combo:combo" as combo
participant "ProcesadorPago:procesadorPago" as procesadorPago
participant "PantallaCocina:pantallaCocina" as cocina

mostrador -> sistema : iniciarNuevoPedido()
create "Pedido:pedido" as pedido
sistema -> pedido : asignarIdentificador(numeroPedido, fechaHora)
pedido --> sistema : numeroPedido

mostrador -> sistema : ingresarReferenciaRetiro(referenciaRetiro)
sistema -> pedido : asignarReferenciaRetiro(referenciaRetiro)

loop por cada ítem seleccionado
    alt selección de producto individual
        mostrador -> sistema : seleccionarProducto(producto, cantidad)
        sistema -> pedido : agregarItem(producto, cantidad)
        create "Item_pedido:itemProducto" as itemProducto
        pedido -> itemProducto : establecerProductoYCantidad(producto, cantidad)
        itemProducto -> producto : obtenerNombre()
        producto --> itemProducto : nombreProducto
        itemProducto -> producto : obtenerPrecio()
        producto --> itemProducto : precioBase
        itemProducto -> itemProducto : conservarPrecioHistorico(precioBase)

        loop por cada personalizacion seleccionada
            mostrador -> sistema : ingresarPersonalizacion(descripcion)
            sistema -> itemProducto : agregarPersonalizacion(descripcion)
            create "Personalizacion_item:personalizacion" as personalizacion
            itemProducto -> personalizacion : obtenerDescripcion()
            personalizacion --> itemProducto : descripcion
            itemProducto -> personalizacion : obtenerCostoAdicional(descripcion)
            personalizacion --> itemProducto : costoAdicional
        end

        itemProducto -> itemProducto : calcularSubtotal(cantidad, precioBase, listaCostosAdicionales)
        itemProducto --> pedido : subtotal

    else selección de combo
        mostrador -> sistema : seleccionarCombo(combo, cantidad)
        sistema -> pedido : agregarItemCombo(combo, cantidad)
        create "Item_pedido:itemCombo" as itemCombo
        pedido -> itemCombo : establecerComboYCantidad(combo, cantidad)
        itemCombo -> combo : obtenerNombre()
        combo --> itemCombo : nombreCombo
        itemCombo -> combo : obtenerPrecio()
        combo --> itemCombo : precioBase
        itemCombo -> itemCombo : conservarPrecioHistorico(precioBase)

        itemCombo -> itemCombo : calcularSubtotal(cantidad, precioBase, ceroCostosAdicionales)
        itemCombo --> pedido : subtotal
    end

    pedido -> pedido : actualizarTotal(subtotal)
end

pedido --> sistema : totalPedido
mostrador -> sistema : seleccionarMedioPago(medioPago)
create "Pago:pago" as pago
sistema -> pago : registrarCobro(medioPago, totalPedido)
pago -> procesadorPago : validarMedioPago(medioPago)
procesadorPago --> pago : resultadoValidacion
pago -> procesadorPago : procesarCobro(medioPago, totalPedido)

alt transferencia rechazada
    procesadorPago --> pago : motivoRechazo
    pago --> sistema : motivoRechazo
    sistema --> mostrador : mensajeRechazo
    destroy pago
    loop por cada ítem temporal creado
        alt ítem de producto individual
            loop por cada personalización creada para el ítem
                destroy personalizacion
            end
            destroy itemProducto
        else ítem de combo
            destroy itemCombo
        end
    end
    destroy pedido
else medio de pago aprobado
    procesadorPago --> pago : comprobanteAprobacion
    pago --> sistema : confirmacionPago
    sistema -> pedido : asociarPago(pago)
    sistema -> pedido : cambiarEstado(RECIBIDO)
    sistema -> pedido : registrarPedido(numeroPedido, fechaHora, referenciaRetiro, listaItems, totalPedido, pago)
    sistema -> cocina : enviarCabeceraPedido(numeroPedido, fechaHora, referenciaRetiro)
    sistema -> cocina : enviarDetallePedido(listaItems, totalPedido)
    sistema -> cocina : informarPedidoConfirmado(numeroPedido)
    cocina --> sistema : acuseRecibo
    sistema --> mostrador : ticketConfirmacion
end
@enduml