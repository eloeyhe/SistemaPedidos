@startuml
title Modificar pedido - estado RECIBIDO
autonumber
skinparam style strictuml
hide footbox

actor "Usuario de Mostrador" as mostrador
participant "PantallaPedidos:interfaz" as interfaz
participant "ServicioPedidos:servicio" as servicio
participant "Pedido:pedido" as pedido
participant "ItemPedido:item" as item
participant "Producto:producto" as producto
participant "PersonalizacionItem:personalizacion" as personalizacion
participant "Pago:pagoOriginal" as pago
participant "ProcesadorPago:procesadorPago" as procesadorPago
participant "HistorialPago:historialPago" as historialPago
participant "HistorialCambioPedido:historialCambios" as historialCambios

mostrador -> interfaz : buscarPedido(numeroOReferencia)
interfaz -> servicio : buscarPedido(numeroOReferencia)
servicio --> interfaz : pedido
interfaz --> mostrador : vistaPedido

mostrador -> interfaz : seleccionarPedidoParaModificar(numeroPedido)
interfaz -> servicio : consultarEstado(numeroPedido)
servicio -> pedido : obtenerEstado()
pedido --> servicio : estado
servicio --> interfaz : estado
interfaz --> mostrador : estado

alt estado inicial == RECIBIDO
    mostrador -> interfaz : modificarItems(listaCambios)
    interfaz -> servicio : modificarItems(numeroPedido, listaCambios)
    servicio -> pedido : prepararModificacion(listaCambios)
    pedido -> item : modificarCantidadYPrecio(cantidad, precioUnitario)
    item -> producto : obtenerNombre()
    producto --> item : nombreProducto
    item -> producto : obtenerPrecio()
    producto --> item : precioBase
    item --> pedido : acuseModificacion
    pedido --> servicio : acuseModificacion
    servicio -> pedido : obtenerTotal()
    pedido --> servicio : totalParcial
    servicio --> interfaz : totalParcial

    mostrador -> interfaz : modificarPersonalizaciones(listaPersonalizaciones)
    interfaz -> servicio : modificarPersonalizaciones(numeroPedido, listaPersonalizaciones)
    servicio -> pedido : prepararPersonalizaciones(listaPersonalizaciones)
    pedido -> item : actualizarPersonalizaciones(listaPersonalizaciones)
    item -> personalizacion : obtenerDescripcion()
    personalizacion --> item : descripcion
    item -> personalizacion : obtenerCostoAdicional(descripcion)
    personalizacion --> item : costoAdicional
    item --> pedido : acuseActualizacion
    pedido -> item : calcularSubtotal(cantidad, precioBase, costosAdicionales)
    item --> pedido : subtotalActualizado
    pedido --> servicio : acusePersonalizaciones
    servicio -> pedido : obtenerTotal()
    pedido --> servicio : totalActualizado

    note over servicio, pago
      Todo pedido registrado tiene un unico pago original (CU1).
      Los ajustes se registran como movimientos de ese pago.
    end note
    servicio -> pedido : obtenerPagoOriginal()
    pedido --> servicio : pagoOriginal
    servicio -> pago : calcularDiferencia(totalAnterior, totalActualizado)
    pago --> servicio : diferencia
    servicio --> interfaz : totalActualizado, diferencia
    interfaz --> mostrador : vistaDiferencia

    mostrador -> interfaz : confirmarModificacion(numeroPedido)
    interfaz -> servicio : consultarEstado(numeroPedido)
    servicio -> pedido : obtenerEstado()
    pedido --> servicio : estadoConfirmacion
    servicio --> interfaz : estadoConfirmacion

    alt estadoConfirmacion == RECIBIDO
        alt diferencia != 0
            mostrador -> interfaz : seleccionarMedioPago(medioPago)
            interfaz -> servicio : seleccionarMedioPago(medioPago)
            servicio -> procesadorPago : validarMedioPago(medioPago)
            procesadorPago --> servicio : resultadoValidacion
            servicio --> interfaz : resultadoValidacion
            alt medioPago válido
                alt diferencia > 0
                    interfaz -> servicio : registrarAjustePago(numeroPedido, medioPago, diferencia, usuario)
                    servicio -> procesadorPago : procesarCobro(medioPago, diferencia)
                    procesadorPago --> servicio : cobroAprobado
                    servicio -> pago : registrarCobroAdicional(medioPago, diferencia)
                    pago -> historialPago : registrarMovimiento(pagoOriginal, AJUSTE, diferencia, motivo, usuario)
                    historialPago --> pago : acuseRegistro
                    pago --> servicio : acuseAjuste
                else diferencia < 0
                    mostrador -> interfaz : confirmarDevolucion(medioPago)
                    interfaz -> servicio : registrarAjustePago(numeroPedido, medioPago, diferencia, usuario)
                    servicio -> pago : registrarDevolucion(medioPago, diferencia)
                    pago -> historialPago : registrarMovimiento(pagoOriginal, DEVOLUCION, diferencia, motivo, usuario)
                    historialPago --> pago : acuseRegistro
                    pago --> servicio : acuseAjuste
                end
                servicio --> interfaz : ajusteRegistrado
            else medioPago inválido
                interfaz --> mostrador : informarMedioPagoInvalido()
                break Se descarta la modificación y no se registra el ajuste
                end
            end
        else diferencia == 0
            servicio --> interfaz : sinAjuste
        end

        interfaz -> servicio : confirmarModificacion(numeroPedido, usuario)
        servicio -> pedido : actualizarPedido(listaItems, totalActualizado)
        pedido -> historialCambios : registrarCambioPedido(pedido, "items", valorAnterior, valorNuevo, usuario)
        pedido -> historialCambios : registrarCambioPedido(pedido, "personalizaciones", valorAnterior, valorNuevo, usuario)
        pedido -> historialCambios : registrarCambioPedido(pedido, "total", totalAnterior, totalActualizado, usuario)
        pedido --> servicio : confirmacionModificacion
        servicio --> interfaz : confirmacionModificacion
        interfaz --> mostrador : ticketModificacion
    else estadoConfirmacion != RECIBIDO
        servicio --> interfaz : motivoRechazo
        interfaz --> mostrador : mensajeRechazo
    end
else estado inicial != RECIBIDO
    interfaz --> mostrador : advertenciaEstadoInvalido
end
@enduml
