@startuml
title Consultar pedidos activos priorizando urgentes
autonumber
skinparam style strictuml
hide footbox

actor UsuarioCocina
actor UsuarioMostrador
participant "PantallaPedidos:pantalla" as pantalla
participant "ServicioPedidos:servicio" as servicio
participant "Pedido:pedido" as pedido
participant "FiltroUrgentes:filtro" as filtro

alt consulta de Cocina
    UsuarioCocina -> pantalla : accederMonitorPedidosActivos()
    pantalla -> servicio : consultarPedidosActivos(UsuarioCocina)
    servicio -> pedido : obtenerPedidosEnEstados(RECIBIDO, EN_PREPARACION, LISTO)
    alt hay pedidos activos
        pedido --> servicio : devolverPedidosActivos(listaPedidos)
        loop por cada pedido activo
            servicio -> pedido : obtenerEstado(numeroPedido)
            pedido --> servicio : devolverEstado(estadoActual)
            servicio -> pedido : consultarPrioridad(numeroPedido)
            pedido --> servicio : devolverPrioridad(esUrgente)
        end
        servicio -> filtro : agruparPorEstado(listaPedidos)
        filtro -> filtro : ordenarUrgentesPorEstado(listaPedidos)
        filtro --> servicio : devolverPedidosOrdenados(listaPedidos)
        servicio --> pantalla : devolverPedidosOrdenados(listaPedidos)
        pantalla --> UsuarioCocina : mostrarMonitorAdaptado(listaPedidos)
        UsuarioCocina -> pantalla : consultarDetallePedido(numeroPedido)
        pantalla -> servicio : obtenerDetallePedido(numeroPedido)
        servicio --> pantalla : devolverDetallePedido(detallePedido)
        pantalla --> UsuarioCocina : mostrarDetallePedido(detallePedido)
    else lista vacia
        pedido --> servicio : devolverListaVacia()
        servicio --> pantalla : informarListaVacia()
        pantalla --> UsuarioCocina : mostrarVistaVacia()
    else falla de conexion
        servicio --> pantalla : informarFallaConexion()
        pantalla --> UsuarioCocina : advertirDatosPosiblementeDesactualizados()
    end
else consulta de Usuario de Mostrador
    UsuarioMostrador -> pantalla : accederMonitorPedidosActivos()
    pantalla -> servicio : consultarPedidosActivos(UsuarioMostrador)
    servicio -> pedido : obtenerPedidosEnEstados(RECIBIDO, EN_PREPARACION, LISTO)
    alt hay pedidos activos
        pedido --> servicio : devolverPedidosActivos(listaPedidos)
        loop por cada pedido activo
            servicio -> pedido : obtenerEstado(numeroPedido)
            pedido --> servicio : devolverEstado(estadoActual)
            servicio -> pedido : consultarPrioridad(numeroPedido)
            pedido --> servicio : devolverPrioridad(esUrgente)
        end
        servicio -> filtro : agruparPorEstado(listaPedidos)
        filtro -> filtro : ordenarUrgentesPorEstado(listaPedidos)
        filtro --> servicio : devolverPedidosOrdenados(listaPedidos)
        servicio --> pantalla : devolverPedidosOrdenados(listaPedidos)
        pantalla --> UsuarioMostrador : mostrarMonitorAdaptado(listaPedidos)
        UsuarioMostrador -> pantalla : consultarDetallePedido(numeroPedido)
        pantalla -> servicio : obtenerDetallePedido(numeroPedido)
        servicio --> pantalla : devolverDetallePedido(detallePedido)
        pantalla --> UsuarioMostrador : mostrarDetallePedido(detallePedido)
    else lista vacia
        pedido --> servicio : devolverListaVacia()
        servicio --> pantalla : informarListaVacia()
        pantalla --> UsuarioMostrador : mostrarVistaVacia()
    else falla de conexion
        servicio --> pantalla : informarFallaConexion()
        pantalla --> UsuarioMostrador : advertirDatosPosiblementeDesactualizados()
    end
end
@enduml