@startuml 04-clases-cambiar-estado-de-pedido-04
title CU04 - Cambiar Estado de Pedido
skinparam classAttributeIconSize 0
hide empty members

abstract class Usuario {
  - nombre: String
  - usuario: String
  - passwordHash: String
  - activo: boolean
}

class UsuarioCocina {
  - estacionTrabajo: String
}

class UsuarioMostrador {
  - numeroCaja: int
}

class PantallaPedidos {
  - servicio: ServicioPedidos
  + seleccionarPedido(numeroPedido: int): void
  + consultarPedidosListos(): List<Pedido>
  + iniciarPreparacion(numeroPedido: int): void
  + finalizarPreparacion(numeroPedido: int): void
  + registrarEntrega(numeroPedido: int): void
}

class ServicioPedidos {
  + consultarEstado(numeroPedido: int): Estado_pedido
  + buscarPedidosPorEstado(estado: Estado_pedido): List<Pedido>
  + solicitarCambioEstado(numeroPedido: int, nuevoEstado: Estado_pedido, actor: Usuario): boolean
}

class Pedido {
  - fecha: Date
  - numeroPedido: int
  - referenciaRetiro: String
  - estado: Estado_pedido
  - prioritario: boolean
  + obtenerEstado(numeroPedido: int): Estado_pedido
  + validarTransicion(estadoActual: Estado_pedido, nuevoEstado: Estado_pedido, actor: Usuario): boolean
  + actualizarEstado(nuevoEstado: Estado_pedido): boolean
}

class Historial_cambio_pedido {
  - campo: String
  - valor_anterior: String
  - valor_nuevo: String
  - fechayhora: DateTime
  + registrarCambioEstado(numeroPedido: int, estadoAnterior: Estado_pedido, estadoNuevo: Estado_pedido, actor: Usuario): boolean
}

enum Estado_pedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

Usuario <|-- UsuarioCocina
Usuario <|-- UsuarioMostrador

UsuarioCocina "0..*" --> "0..*" PantallaPedidos : interactua
UsuarioMostrador "0..*" --> "0..*" PantallaPedidos : interactua

PantallaPedidos "0..*" --> "1" ServicioPedidos : utiliza
ServicioPedidos ..> Pedido : consulta y actualiza
ServicioPedidos ..> Historial_cambio_pedido : registra

Pedido "0..*" --> "1" Estado_pedido : estado actual
Pedido "1" <-- "0..*" Historial_cambio_pedido : pedido
Historial_cambio_pedido "0..*" --> "1" Usuario : actor

ServicioPedidos ..> Estado_pedido : valida transicion
Historial_cambio_pedido ..> Estado_pedido : registra estados
@enduml