@startuml
scale 0.8
title CU02 - Modificar Pedido
top to bottom direction
hide circle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
skinparam classFontSize 15
skinparam classAttributeFontSize 13
skinparam dpi 160

abstract class Usuario {
  -nombre: String
  -usuario: String
  -passwordHash: String
  -activo: Boolean
  +autentificar(usuario: String, password: String): Boolean
}

class UsuarioMostrador {
  -numeroCaja: Integer
  +modificarPedido(pedido: Pedido): void
}

class PantallaPedidos <<boundary>> {
  +buscarPedido(numeroOReferencia: String): Pedido
  +seleccionarPedidoParaModificar(numeroPedido: Integer): void
  +modificarItems(listaCambios: List<ItemPedido>): void
  +modificarPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +confirmarModificacion(numeroPedido: Integer): void
  +seleccionarMedioPago(medioPago: MetodoPago): void
  +confirmarDevolucion(medioPago: MetodoPago): void
}

class ServicioPedidos <<control>> {
  +buscarPedido(numeroOReferencia: String): Pedido
  +consultarEstado(numeroPedido: Integer): EstadoPedido
  +modificarItems(numeroPedido: Integer, listaCambios: List<ItemPedido>): Decimal
  +modificarPersonalizaciones(numeroPedido: Integer, listaPersonalizaciones: List<PersonalizacionItem>): Decimal
  +seleccionarMedioPago(medioPago: MetodoPago): String
  +registrarAjustePago(numeroPedido: Integer, medioPago: MetodoPago, diferencia: Decimal, usuario: Usuario): Boolean
  +confirmarModificacion(numeroPedido: Integer, usuario: Usuario): Boolean
}

class Pedido {
  -fechaHora: DateTime
  -estado: EstadoPedido
  -prioritario: Boolean
  -numeroPedido: Integer
  -referenciaRetiro: String
  -total: Decimal
  +obtenerEstado(): EstadoPedido
  +obtenerTotal(): Decimal
  +obtenerPagoOriginal(): Pago
  +prepararModificacion(listaCambios: List<ItemPedido>): void
  +prepararPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +actualizarPedido(listaItems: List<ItemPedido>, totalActualizado: Decimal): void
}

class ItemPedido {
  -cantidad: Integer
  -precioUnitario: Decimal
  -subtotal: Decimal
  +modificarCantidadYPrecio(cantidad: Integer, precioUnitario: Decimal): void
  +actualizarPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +calcularSubtotal(cantidad: Integer, precioBase: Decimal, costosAdicionales: List<Decimal>): Decimal
  +agregarPersonalizacion(descripcion: String): PersonalizacionItem
  +quitarPersonalizacion(personalizacion: PersonalizacionItem): void
  +recalcularPrecio(): Decimal
}

abstract class Producto {
  -nombre: String
  -precio: Decimal
  +obtenerNombre(): String
  +obtenerPrecio(): Decimal
}

class PersonalizacionItem {
  -descripcion: String
  -costoAdicional: Decimal
  +obtenerDescripcion(): String
  +obtenerCostoAdicional(descripcion: String): Decimal
  +calcularCosto(): Decimal
}

class Pago {
  -monto: Decimal
  -metodoDePago: MetodoPago
  -fechaHora: DateTime
  +calcularDiferencia(totalAnterior: Decimal, totalActualizado: Decimal): Decimal
  +registrarCobroAdicional(medioPago: MetodoPago, diferencia: Decimal): void
  +registrarDevolucion(medioPago: MetodoPago, diferencia: Decimal): void
}

class ProcesadorPago <<service>> {
  +validarMedioPago(medioPago: MetodoPago): Boolean
  +procesarCobro(medioPago: MetodoPago, monto: Decimal): Boolean
}

class HistorialPago {
  -tipo: TipoMovimiento
  -monto: Decimal
  -motivo: String
  -fechaHora: DateTime
  +registrarMovimiento(pago: Pago, tipo: TipoMovimiento, monto: Decimal, motivo: String, usuario: Usuario): void
}

class HistorialCambioPedido {
  -campo: String
  -valorAnterior: String
  -valorNuevo: String
  -fechaHora: DateTime
  +registrarCambioPedido(pedido: Pedido, campo: String, valorAnterior: String, valorNuevo: String, usuario: Usuario): void
}

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoMovimiento {
  COBRO_INICIAL
  AJUSTE
  DEVOLUCION
}

' Herencia
UsuarioMostrador --|> Usuario

' Dependencias
UsuarioMostrador ..> PantallaPedidos : interactua
PantallaPedidos ..> ServicioPedidos : solicita operaciones
ServicioPedidos ..> Pedido : consulta y modifica
ServicioPedidos ..> Pago : calcula y registra ajustes
ServicioPedidos ..> ProcesadorPago : valida medio y cobra

' Composiciones
Pedido "1" *-- "1..*" ItemPedido : items
ItemPedido "1" *-- "0..*" PersonalizacionItem : personalizaciones

' Asociaciones
ItemPedido "0..*" --> "0..1" Producto : producto
Pedido "1" -- "1" Pago : pago original
Pago "1" -- "0..*" HistorialPago : movimientos
Pedido "1" -- "0..*" HistorialCambioPedido : cambios

' Asociaciones con Usuario
HistorialPago "0..*" --> "1" Usuario : usuario
HistorialCambioPedido "0..*" --> "1" Usuario : usuario

' Enumeraciones
Pedido --> EstadoPedido
Pago --> MetodoPago
HistorialPago --> TipoMovimiento

note bottom of Pago
  Un unico pago original por pedido (CU1).
  Cobros adicionales y devoluciones se registran
  como movimientos AJUSTE / DEVOLUCION en HistorialPago.
end note

@enduml
