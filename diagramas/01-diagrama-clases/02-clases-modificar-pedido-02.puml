@startuml
scale 0.9
title CU02 - Modificar Pedido
top to bottom direction
hide circle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
skinparam classFontSize 15
skinparam classAttributeFontSize 13
skinparam dpi 160

abstract class Usuario {
  -nombre: String
  -usuario: String
  -passwordHash: String
  -activo: Boolean
  +autentificar(): Boolean
}

class UsuarioMostrador {
  -numeroCaja: Integer
  +modificarPedido(): void
}

class PantallaPedidos {
  +buscarPedido(numeroOReferencia: String): Pedido
  +seleccionarPedidoParaModificar(numeroPedido: Integer): void
  +modificarItems(listaCambios: List<ItemPedido>): void
  +modificarPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +confirmarModificacion(numeroPedido: Integer): void
  +seleccionarMedioPago(medioPago: MetodoPago): void
  +confirmarDevolucion(medioPago: MetodoPago): void
}

class Pedido {
  -fecha: Date
  -estado: EstadoPedido
  -prioritario: Boolean
  -numeroPedido: Integer
  -referenciaRetiro: String
  +buscarPedido(numeroOReferencia: String): Pedido
  +verificarEstado(numeroPedido: Integer): EstadoPedido
  +modificar(): void
  +prepararModificacion(listaCambios: List<ItemPedido>): void
  +prepararPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +verificarEstadoAlConfirmar(numeroPedido: Integer): EstadoPedido
  +actualizarPedido(numeroPedido: Integer, listaItems: List<ItemPedido>, totalActualizado: Decimal): void
}

class ItemPedido {
  -cantidad: Integer
  -precioUnitario: Decimal
  -subtotal: Decimal
  +modificarCantidadYPrecio(cantidad: Integer, precioUnitario: Decimal): void
  +actualizarPersonalizaciones(listaPersonalizaciones: List<PersonalizacionItem>): void
  +calcularSubtotal(cantidad: Integer, precioUnitario: Decimal, listaPersonalizaciones: List<PersonalizacionItem>): Decimal
  +agregarPersonalizacion(personalizacion: PersonalizacionItem): void
  +quitarPersonalizacion(personalizacion: PersonalizacionItem): void
  +recalcularPrecio(): Decimal
}

abstract class Producto {
  -nombre: String
  -precio: Decimal
  +obtenerNombre(): String
  +obtenerPrecio(): Decimal
}

class PersonalizacionItem {
  -descripcion: String
  -costoAdicional: Decimal
  +calcularCosto(): Decimal
  +obtenerDescripcion(): String
  +obtenerCostoAdicional(): Decimal
}

class Pago {
  -monto: Decimal
  -metodoDePago: MetodoPago
  +calcularDiferencia(totalAnterior: Decimal, totalActualizado: Decimal): Decimal
  +validarMedioPago(medioPago: MetodoPago): Boolean
  +consultarPagoOriginal(numeroPedido: Integer): Pago
  +registrarCobroAdicional(medioPago: MetodoPago, diferencia: Decimal): void
  +registrarDevolucion(medioPago: MetodoPago, diferencia: Decimal): void
}

class ProcesadorPago {
  +validarMedioPago(medioPago: MetodoPago): Boolean
}

class HistorialPago {
  -tipo: TipoMovimiento
  -monto: Decimal
  -motivo: String
  -fechayhora: DateTime
  +registrarMovimiento(pago: Pago, tipo: TipoMovimiento, monto: Decimal, motivo: String, usuario: Usuario): void
}

class HistorialCambioPedido {
  -campo: String
  -valorAnterior: String
  -valorNuevo: String
  -fechayhora: DateTime
  +registrarCambioPedido(pedido: Pedido, campo: String, valorAnterior: String, valorNuevo: String, usuario: Usuario): void
  }

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoMovimiento {
  COBRO_INICIAL
  AJUSTE
  DEVOLUCION
}

' Herencia
UsuarioMostrador --|> Usuario

' Dependencias
UsuarioMostrador ..> PantallaPedidos : interactua
PantallaPedidos ..> Pedido
PantallaPedidos ..> Pago
Pago ..> ProcesadorPago

' Composiciones
Pedido "1" *-- "1..*" ItemPedido : items
ItemPedido "1" *-- "0..*" PersonalizacionItem : personalizaciones

' Asociaciones
ItemPedido "0..*" --> "1" Producto : producto
Pedido "1" -- "0..*" Pago : pagos
Pago "1" -- "0..*" HistorialPago : movimientos
Pedido "1" -- "0..*" HistorialCambioPedido : cambios

' Asociaciones con Usuario
HistorialPago "0..*" --> "1" Usuario : usuario
HistorialCambioPedido "0..*" --> "1" Usuario : usuario

' Enumeraciones
Pedido --> EstadoPedido
Pago --> MetodoPago
HistorialPago --> TipoMovimiento

@enduml