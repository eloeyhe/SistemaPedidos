@startuml 01-solid-05-dip
skinparam classAttributeIconSize 0

' Dominio y Abstracción del Catálogo
interface IElementoMenu {
    + getNombre(): String
    + getPrecio(): Double
}

class Producto implements IElementoMenu {
    - Producto: String
    - nombre: String
    - precioBase: Double
    + getNombre(): String
    + getPrecio(): Double
}

class Combo implements IElementoMenu {
    - Combo: String
    - nombre: String
    - descuento: Double
    + getNombre(): String
    + getPrecio(): Double
}

class Item_pedido {
    - cantidad: Integer
    - elemento: IElementoMenu
    + calcularSubtotal(): Double

}

Item_pedido --> IElementoMenu

' Puertos de Infraestructura (Interfaces)

interface IRepositorioPedidos {
    + guardar(pedido: Pedido): Boolean
}

interface ICatalogoMenu {
    + buscarPorId(id: String): IElementoMenu
}

interface IPublicadorComandasCocina {
    + publicarComanda(pedido: Pedido): void
}

' Servicio de Aplicación e Inyección de Dependencias

class ServicioTomarPedido {
    - repositorioPedidos: IRepositorioPedidos
    - catalogoMenu: ICatalogoMenu
    - publicadorCocina: IPublicadorComandasCocina
    + ServicioTomarPedido(repo: IRepositorioPedidos, cat: ICatalogoMenu, pub: IPublicadorComandasCocina)
    + ejecutar(datosPedido: Object): void
}

ServicioTomarPedido --> IRepositorioPedidos
ServicioTomarPedido --> ICatalogoMenu
ServicioTomarPedido --> IPublicadorComandasCocina

@enduml