@startuml 06-clases-diagrama-final
title Diagrama de Clases Final - Sistema de Pedidos
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

package "Presentacion e integracion" {
  class PantallaPedidos <<boundary>> {
    + tomarPedido(): void
    + buscarPedido(numeroOReferencia: String): Pedido
    + modificarPedido(numeroPedido: int): void
    + solicitarCancelacionPedido(numeroPedido: int): void
    + confirmarCancelacion(motivo: String): void
    + seleccionarPedido(numeroPedido: int): void
    + iniciarPreparacion(numeroPedido: int): void
    + finalizarPreparacion(numeroPedido: int): void
    + registrarEntrega(numeroPedido: int): void
    + marcarPrioritario(numeroPedido: int): void
    + consultarPedidosActivos(): void
    + consultarDetallePedido(numeroPedido: int): void
  }

  class PantallaCocina <<boundary>> {
    + enviarCabeceraPedido(numeroPedido: int, fechaHora: DateTime, referenciaRetiro: String): void
    + enviarDetallePedido(items: List<ItemPedido>, total: decimal): void
    + informarPedidoConfirmado(numeroPedido: int): boolean
  }

  class ProcesadorPago <<service>> {
    + validarMedioPago(medioPago: MetodoPago): boolean
    + procesarCobro(medioPago: MetodoPago, monto: decimal): boolean
    + obtenerMotivoRechazo(): String
  }
}

package "Aplicacion" {
  class ServicioPedidos <<control>> {
    - pedidos: List<Pedido>
    - pedidoEnCurso: Pedido
    - itemEnCurso: ItemPedido
    - ultimoNumeroPedido: int
    + iniciarNuevoPedido(): Pedido
    + ingresarReferenciaRetiro(referenciaRetiro: String): void
    + seleccionarProducto(producto: Producto, cantidad: int): void
    + seleccionarCombo(combo: Combo, cantidad: int): void
    + ingresarPersonalizacion(descripcion: String): void
    + marcarPrioritario(numeroPedido: int): void
    + seleccionarMedioPago(medioPago: MetodoPago): String
    + descartarPedidoEnCurso(): void
    + buscarPedido(numeroOReferencia: String): Pedido
    + modificarPedido(numeroPedido: int): void
    + cancelarPedido(numeroPedido: int, motivo: String, actor: Usuario): boolean
    + cancelarPedido(numeroPedido: int, motivo: String, actor: Usuario, autorizante: UsuarioEncargado): boolean
    + consultarEstado(numeroPedido: int): EstadoPedido
    + solicitarCambioEstado(numeroPedido: int, nuevoEstado: EstadoPedido, actor: Usuario): boolean
    + buscarPedidosPorEstado(estado: EstadoPedido): List<Pedido>
    + consultarPedidosActivos(actorSolicitante: Usuario): Map<EstadoPedido, List<Pedido>>
    + agruparPedidosPorEstado(pedidos: List<Pedido>): Map<EstadoPedido, List<Pedido>>
    + ordenarGrupoPorPrioridad(urgentesPrimero: boolean): void
    + seleccionarEstadosVisibles(actor: Usuario): List<EstadoPedido>
    + obtenerDetallePedido(numeroPedido: int): List<ItemPedido>
    - generarNumeroPedido(): int
  }
}

package "Dominio" {
  abstract class Usuario {
    # nombre: String
    # usuario: String
    # passwordHash: String
    # activo: boolean
    + autentificar(usuario: String, password: String): boolean
  }

  class UsuarioMostrador {
    - numeroCaja: int
    + modificarPedido(pedido: Pedido): void
    + marcarComoEntregado(pedido: Pedido): void
  }

  class UsuarioCocina {
    - estacionTrabajo: String
    + iniciarPreparacion(pedido: Pedido): void
    + marcarPedidoListo(pedido: Pedido): void
  }

  class UsuarioEncargado {
    - claveSupervision: String
    + autorizarCancelacion(): boolean
    + validarClaveSupervision(clave: String): boolean
  }

  class Pedido {
    - fechaHora: DateTime
    - numeroPedido: int
    - referenciaRetiro: String
    - estado: EstadoPedido
    - prioritario: boolean
    - total: decimal
    + asignarIdentificador(numeroPedido: int, fechaHora: DateTime): int
    + asignarReferenciaRetiro(referencia: String): void
    + agregarItem(producto: Producto, cantidad: int): ItemPedido
    + agregarItemCombo(combo: Combo, cantidad: int): ItemPedido
    - actualizarTotal(subtotal: decimal): void
    + obtenerTotal(): decimal
    + priorizar(): void
    + asociarPago(pago: Pago): void
    + registrarPedido(numeroPedido: int, fechaHora: DateTime, referenciaRetiro: String, listaItems: List<ItemPedido>, totalPedido: decimal, pago: Pago): boolean
    + obtenerEstado(): EstadoPedido
    + validarTransicion(nuevoEstado: EstadoPedido, actor: Usuario): boolean
    + cambiarEstado(nuevoEstado: EstadoPedido): void
    + cancelarPedido(motivo: String): void
    + modificar(): void
    + esPrioritario(): boolean
    + obtenerDetalle(): List<ItemPedido>
  }

  class ItemPedido {
    - cantidad: int
    - precioUnitario: decimal
    - subtotal: decimal
    + establecerProductoYCantidad(producto: Producto, cantidad: int): void
    + establecerComboYCantidad(combo: Combo, cantidad: int): void
    - conservarPrecioHistorico(precioBase: decimal): void
    + agregarPersonalizacion(descripcion: String): PersonalizacionItem
    + quitarPersonalizacion(personalizacion: PersonalizacionItem): void
    + calcularSubtotal(): decimal
    + recalcularPrecio(): decimal
  }

  class PersonalizacionItem {
    - descripcion: String
    - costoAdicional: decimal
    + calcularCosto(): decimal
  }

  abstract class Producto {
    # nombre: String
    # precio: decimal
    + obtenerNombre(): String
    + obtenerPrecio(): decimal
    + cambiarPrecio(nuevoPrecio: decimal): void
  }

  class ProductoPreparado {
    - tiempoPreparacion: int
    + iniciarPreparacion(): void
  }

  class ProductoEnvasado {
    - fechaElaboracion: Date
    - fechaVencimiento: Date
  }

  class Combo {
    - nombre: String
    - precio: decimal
    + obtenerNombre(): String
    + obtenerPrecio(): decimal
  }

  class Pago {
    - monto: decimal
    - metodoDePago: MetodoPago
    - fechaHora: DateTime
    + registrarCobro(medioPago: MetodoPago, monto: decimal): boolean
    + calcularDiferencia(totalAnterior: decimal, totalActualizado: decimal): decimal
    + registrarCobroAdicional(medioPago: MetodoPago, diferencia: decimal): void
    + registrarDevolucion(medioPago: MetodoPago, diferencia: decimal): void
  }

  class HistorialPago {
    - tipo: TipoMovimiento
    - monto: decimal
    - motivo: String
    - fechaHora: DateTime
    + registrarMovimiento(pago: Pago, tipo: TipoMovimiento, monto: decimal, motivo: String, usuario: Usuario): void
  }

  class AuditoriaPedido {
    - accion: String
    - detalles: String
    - motivo: String
    - fechaHora: DateTime
    + registrarAccion(pedido: Pedido, usuario: Usuario, accion: String, fechaHora: DateTime): void
    + registrarAccion(pedido: Pedido, usuario: Usuario, autorizante: UsuarioEncargado, accion: String, fechaHora: DateTime): void
    + registrarDetalles(motivo: String, estadoAnterior: EstadoPedido, estadoNuevo: EstadoPedido): void
  }

  class HistorialCambioPedido {
    - campo: String
    - valorAnterior: String
    - valorNuevo: String
    - fechaHora: DateTime
    + registrarCambioPedido(pedido: Pedido, campo: String, valorAnterior: String, valorNuevo: String, usuario: Usuario): void
    + registrarCambioEstado(pedido: Pedido, estadoAnterior: EstadoPedido, estadoNuevo: EstadoPedido, actor: Usuario): boolean
  }

  enum EstadoPedido {
    RECIBIDO
    EN_PREPARACION
    LISTO
    ENTREGADO
    CANCELADO
  }

  enum MetodoPago {
    EFECTIVO
    TRANSFERENCIA
  }

  enum TipoMovimiento {
    COBRO_INICIAL
    AJUSTE
    DEVOLUCION
  }
}

Usuario <|-- UsuarioMostrador
Usuario <|-- UsuarioCocina
Usuario <|-- UsuarioEncargado
Producto <|-- ProductoPreparado
Producto <|-- ProductoEnvasado

ServicioPedidos "1" o-- "0..*" Pedido : gestiona
UsuarioMostrador --> PantallaPedidos : opera
UsuarioCocina --> PantallaPedidos : consulta y actualiza
UsuarioEncargado --> PantallaPedidos : autoriza
Pedido "1" *-- "1..*" ItemPedido : contiene
ItemPedido "1" *-- "0..*" PersonalizacionItem : personalizaciones
ItemPedido "0..*" --> "0..1" Producto : producto
ItemPedido "0..*" --> "0..1" Combo : combo
Pedido "1" -- "1" Pago : pago original
Pago "1" -- "0..*" HistorialPago : movimientos
Pedido "1" -- "0..*" HistorialCambioPedido : cambios
Pedido "1" -- "0..*" AuditoriaPedido : auditoria
HistorialPago "0..*" --> "1" Usuario : responsable
HistorialCambioPedido "0..*" --> "1" Usuario : actor
AuditoriaPedido "0..*" --> "1" Usuario : responsable
AuditoriaPedido "0..*" --> "0..1" UsuarioEncargado : autorizante

PantallaPedidos ..> ServicioPedidos : interactua
ServicioPedidos ..> ProcesadorPago : procesa pagos
ServicioPedidos ..> PantallaCocina : envia pedidos confirmados
ServicioPedidos ..> HistorialCambioPedido : registra cambios
ServicioPedidos ..> AuditoriaPedido : registra acciones
ServicioPedidos ..> EstadoPedido : valida y filtra
ServicioPedidos ..> Usuario : adapta consultas
Pago ..> MetodoPago
HistorialPago ..> TipoMovimiento
Pedido ..> EstadoPedido

note right of ItemPedido
  Cada item referencia un Producto
  o un Combo, pero no ambos.
  precioUnitario conserva el precio
  vigente al registrar el pedido.
end note

note bottom of Usuario
  Cliente es un actor externo y no una
  clase persistente: no se registra una
  ficha de cliente (RF6).
end note

@enduml