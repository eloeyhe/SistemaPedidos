@startuml 05-clases-consultar-pedidos-activos-05
title CU05 - Consultar Pedidos Activos
skinparam classAttributeIconSize 0
hide empty members

abstract class Usuario {
  - nombre: String
  - usuario: String
  - passwordHash: String
  - activo: boolean
}

class UsuarioCocina {
  - estacionTrabajo: String
}

class UsuarioMostrador {
  - numeroCaja: int
}

class PantallaPedidos {
  - servicio: ServicioPedidos
  + accederMonitorPedidosActivos(): void
  + consultarDetallePedido(numeroPedido: int): void
}

class ServicioPedidos {
  + consultarPedidosActivos(actorSolicitante: Usuario): Map<EstadoPedido, List<Pedido>>
  + comprobarDisponibilidadDatos(): boolean
  + agruparPedidosPorEstado(listaPedidosActivos: List<Pedido>): Map<EstadoPedido, List<Pedido>>
  + ordenarGrupoPorPrioridad(urgentesPrimero: boolean): void
  + seleccionarEstadosVisibles(actor: Usuario): List<EstadoPedido>
  + obtenerDetallePedido(numeroPedido: int): List<ItemPedido>
}

class Pedido {
  - fecha: Date
  - estado: EstadoPedido
  - prioritario: boolean
  - numeroPedido: int
  - referenciaRetiro: String
  + obtenerPedidosPorEstados(estado1: EstadoPedido, estado2: EstadoPedido, estado3: EstadoPedido): List<Pedido>
  + obtenerEstado(): EstadoPedido
  + esPrioritario(): boolean
  + obtenerDetalle(): List<ItemPedido>
}

class ItemPedido {
  - cantidad: int
  - precioUnitario: Decimal
  - subtotal: Decimal
}

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

Usuario <|-- UsuarioCocina
Usuario <|-- UsuarioMostrador

UsuarioCocina "0..*" --> "0..*" PantallaPedidos : consulta
UsuarioMostrador "0..*" --> "0..*" PantallaPedidos : consulta

PantallaPedidos "0..*" --> "1" ServicioPedidos : consulta
Pedido "0..*" --> "1" EstadoPedido : estado
Pedido "1" *-- "1..*" ItemPedido : detalle

ServicioPedidos ..> Pedido : filtra y consulta
ServicioPedidos ..> EstadoPedido : agrupa y filtra
ServicioPedidos ..> ItemPedido : obtiene detalle
ServicioPedidos ..> Usuario : adapta vista
@enduml