@startuml 05-clases-consultar-pedidos-activos-05
title CU05 - Consultar Pedidos Activos
skinparam classAttributeIconSize 0
hide empty members

abstract class Usuario {
  - nombre: String
  - usuario: String
  - passwordHash: String
  - activo: boolean
}

class UsuarioCocina {
  - estacionTrabajo: String
}

class UsuarioMostrador {
  - numeroCaja: int
}

class PantallaPedidos {
  - servicio: ServicioPedidos
  + accederMonitorPedidosActivos(): void
  + consultarDetallePedido(numeroPedido: int): void
}

class ServicioPedidos {
  + consultarPedidosActivos(actorSolicitante: Usuario): Map<Estado_pedido, List<Pedido>>
  + comprobarDisponibilidadDatos(): boolean
  + agruparPedidosPorEstado(listaPedidosActivos: List<Pedido>): Map<Estado_pedido, List<Pedido>>
  + ordenarGrupoPorPrioridad(urgentesPrimero: boolean): void
  + seleccionarEstadosVisibles(estado1: Estado_pedido, estado2: Estado_pedido): List<Estado_pedido>
  + seleccionarEstadosVisibles(estado1: Estado_pedido, estado2: Estado_pedido, estado3: Estado_pedido): List<Estado_pedido>
  + obtenerDetallePedido(numeroPedido: int): List<Item_pedido>
}

class Pedido {
  - fecha: Date
  - estado: Estado_pedido
  - prioritario: boolean
  - numeroPedido: int
  - referenciaRetiro: String
  + obtenerPedidosPorEstados(estado1: Estado_pedido, estado2: Estado_pedido, estado3: Estado_pedido): List<Pedido>
  + obtenerEstado(): Estado_pedido
  + esPrioritario(): boolean
  + obtenerDetalle(): List<Item_pedido>
}

class Item_pedido {
  - cantidad: int
  - precioUnitario: Decimal
  - subtotal: Decimal
}

enum Estado_pedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

Usuario <|-- UsuarioCocina
Usuario <|-- UsuarioMostrador

UsuarioCocina "0..*" --> "0..*" PantallaPedidos : consulta
UsuarioMostrador "0..*" --> "0..*" PantallaPedidos : consulta

PantallaPedidos "0..*" --> "1" ServicioPedidos : consulta
Pedido "0..*" --> "1" Estado_pedido : estado
Pedido "1" *-- "1..*" Item_pedido : detalle

ServicioPedidos ..> Pedido : filtra y consulta
ServicioPedidos ..> Estado_pedido : agrupa y filtra
ServicioPedidos ..> Item_pedido : obtiene detalle
ServicioPedidos ..> Usuario : adapta vista
@enduml