@startuml
title Sistema de Pedidos - Refactorización aplicando SRP

skinparam classAttributeIconSize 0
hide empty members

class Pedido {
  - numeroPedido: String
  - fecha: DateTime
  - referenciaRetiro: String
  - estado: EstadoPedido
  - prioritario: Boolean
  + agregarItem(item: ItemPedido): void
  + modificarItem(item: ItemPedido): void
  + cancelar(): void
  + cambiarEstado(nuevoEstado: EstadoPedido): void
  + marcarPrioritario(): void
  + calcularTotal(): Decimal
}

class ItemPedido {
  - cantidad: int
  - elemento: IElementoMenu
  - precioUnitarioHistorico: Decimal
  + agregarPersonalizacion(personalizacion: PersonalizacionItem): void
  + quitarPersonalizacion(personalizacion: PersonalizacionItem): void
  + calcularSubtotal(): Decimal
}

interface IElementoMenu {
  + getPrecio(): Decimal
}

class Producto implements IElementoMenu {
  - nombre: String
  - precioBase: Decimal
  + getPrecio(): Decimal
}

class Combo implements IElementoMenu {
  - nombre: String
  - precioPropio: Decimal
  + getPrecio(): Decimal
}

class PersonalizacionItem {
  - descripcion: String
  - costoAdicional: Decimal
  + calcularCosto(): Decimal
}

class Pago {
  - monto: Decimal
  - metodoDePago: MetodoPago
  - fechaHora: DateTime
}

class HistorialPago {
  - tipo: TipoMovimiento
  - monto: Decimal
  - motivo: String
  - fechaHora: DateTime
  + registrar(): void
}

class PoliticaCicloPedido <<policy>> {
  + validarModificacion(pedido: Pedido): void
  + validarTransicion(actual: EstadoPedido, nuevo: EstadoPedido): Boolean
  + validarCancelacion(pedido: Pedido): void
}

class ServicioRegistroPago <<service>> {
  + registrarCobro(pedido: Pedido, monto: Decimal, metodo: MetodoPago): Pago
  + registrarAjuste(pago: Pago, diferencia: Decimal): HistorialPago
}

class CalculadorAjustePago <<service>> {
  + calcularDiferencia(totalAnterior: Decimal, totalNuevo: Decimal): Decimal
}

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoMovimiento {
  COBRO_INICIAL
  AJUSTE
  DEVOLUCION
}

Pedido "1" *-- "1..*" ItemPedido : contiene
ItemPedido "0..*" --> "1" IElementoMenu : elemento seleccionado
Producto ..|> IElementoMenu
Combo ..|> IElementoMenu
ItemPedido "1" *-- "0..*" PersonalizacionItem : personalizaciones
Pedido "1" -- "0..1" Pago : pago
Pago "1" *-- "1..*" HistorialPago : movimientos

Pedido ..> PoliticaCicloPedido : solicitar validacion

  note right of Pedido
  cambiarEstado() y cancelar()
  actualizan el estado de Pedido
  solo si PoliticaCicloPedido
  valida la operación.
  end note

ServicioRegistroPago ..> Pago : registra
ServicioRegistroPago ..> HistorialPago : registra movimientos
ServicioRegistroPago ..> CalculadorAjustePago : solicita cálculo




@enduml