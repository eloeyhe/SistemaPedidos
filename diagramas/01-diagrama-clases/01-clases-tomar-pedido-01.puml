@startuml 01-clases-tomar-pedido-01
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
skinparam ArrowFontSize 11
hide empty members

title Diagrama de Clases - Tomar Pedido (CU01)

' ===================== Usuarios =====================
abstract class Usuario {
  # nombre : String
  # usuario : String
  # passwordHash : String
  # activo : boolean
  + autentificar(usuario : String, password : String) : boolean
}

class UsuarioMostrador {
  - numeroCaja : int
  + modificarPedido(pedido : Pedido) : void
  + marcarComoEntregado(pedido : Pedido) : void
}

' ===================== Control / frontera (diagrama de secuencia) =====================
class ServicioPedidos <<control>> {
  - pedidos : List<Pedido>
  - pedidoEnCurso : Pedido
  - itemEnCurso : ItemPedido
  - ultimoNumeroPedido : int
  + iniciarNuevoPedido() : Pedido
  + ingresarReferenciaRetiro(referenciaRetiro : String) : void
  + seleccionarProducto(producto : Producto, cantidad : int) : void
  + seleccionarCombo(combo : Combo, cantidad : int) : void
  + ingresarPersonalizacion(descripcion : String) : void
  + seleccionarMedioPago(medioPago : MetodoPago) : String
  - generarNumeroPedido() : int
  + descartarPedidoEnCurso() : void
}

class PantallaCocina <<boundary>> {
  + enviarCabeceraPedido(numeroPedido : int, fechaHora : DateTime, referenciaRetiro : String) : void
  + enviarDetallePedido(listaItems : List<ItemPedido>, totalPedido : decimal) : void
  + informarPedidoConfirmado(numeroPedido : int) : boolean
}

class ProcesadorPago <<service>> {
  + validarMedioPago(medioPago : MetodoPago) : boolean
  + procesarCobro(medioPago : MetodoPago, monto : decimal) : boolean
  + obtenerMotivoRechazo() : String
}

' ===================== Dominio =====================
class Pedido {
  - numeroPedido : int
  - fechaHora : DateTime
  - referenciaRetiro : String
  - estado : EstadoPedido
  - prioritario : boolean
  - total : decimal
  - items : List<ItemPedido>
  - pago : Pago
  - creadoPor : UsuarioMostrador
  + asignarIdentificador(numeroPedido : int, fechaHora : DateTime) : int
  + asignarReferenciaRetiro(referenciaRetiro : String) : void
  + agregarItem(producto : Producto, cantidad : int) : ItemPedido
  + agregarItemCombo(combo : Combo, cantidad : int) : ItemPedido
  - actualizarTotal(subtotal : decimal) : void
  + obtenerTotal() : decimal
  + priorizar() : void
  + asociarPago(pago : Pago) : void
  + cambiarEstado(nuevoEstado : EstadoPedido) : void
  + registrarPedido(numeroPedido : int, fechaHora : DateTime, referenciaRetiro : String, listaItems : List<ItemPedido>, totalPedido : decimal, pago : Pago) : boolean
}

class ItemPedido {
  - cantidad : int
  - precioUnitario : decimal
  - subtotal : decimal
  - producto : Producto
  - combo : Combo
  - personalizaciones : List<PersonalizacionItem>
  + establecerProductoYCantidad(producto : Producto, cantidad : int) : void
  + establecerComboYCantidad(combo : Combo, cantidad : int) : void
  - conservarPrecioHistorico(precioBase : decimal) : void
  + agregarPersonalizacion(descripcion : String) : PersonalizacionItem
  + quitarPersonalizacion(personalizacion : PersonalizacionItem) : void
  + calcularSubtotal(cantidad : int, precioBase : decimal, costosAdicionales : List<decimal>) : decimal
}

class PersonalizacionItem {
  - descripcion : String
  - costoAdicional : decimal
  + obtenerDescripcion() : String
  + obtenerCostoAdicional(descripcion : String) : decimal
  + calcularCosto() : decimal
}

abstract class Producto {
  # nombre : String
  # precio : decimal
  + obtenerNombre() : String
  + obtenerPrecio() : decimal
  + cambiarPrecio(nuevoPrecio : decimal) : void
}

class ProductoPreparado {
  - tiempoPreparacion : int
  + iniciarPreparacion() : void
}

class ProductoEnvasado {
  - fechaElaboracion : Date
  - fechaVencimiento : Date
}

class Combo {
  - nombre : String
  - precio : decimal
  + obtenerNombre() : String
  + obtenerPrecio() : decimal
}

class Pago {
  - monto : decimal
  - metodoDePago : MetodoPago
  - fechaHora : DateTime
  + registrarCobro(medioPago : MetodoPago, monto : decimal) : boolean
  + calcularDiferencia(nuevoTotal : decimal) : decimal
}

enum EstadoPedido <<enumeration>> {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago <<enumeration>> {
  EFECTIVO
  TRANSFERENCIA
}

' ===================== Relaciones =====================
' Herencia
Usuario <|-- UsuarioMostrador
Producto <|-- ProductoPreparado
Producto <|-- ProductoEnvasado

' Agregación: el sistema agrupa los pedidos, pero estos persisten por auditoría (RF5)
ServicioPedidos "1" o-- "0..*" Pedido : gestiona >

' Composición: los ítems y sus personalizaciones no existen fuera de su todo
Pedido "1" *-- "1..*" ItemPedido : contiene >
ItemPedido "1" *-- "0..*" PersonalizacionItem : aplica >

' Asociaciones
ItemPedido "0..*" --> "0..1" Producto : referencia >
ItemPedido "0..*" --> "0..1" Combo : referencia >
Pedido "1" -- "0..1" Pago : se abona con >
Pedido "0..*" --> "1" UsuarioMostrador : creadoPor >
ServicioPedidos "1" --> "1" PantallaCocina : notifica >

' Dependencias
UsuarioMostrador ..> ServicioPedidos : <<use>>
ServicioPedidos ..> Pago : <<create>>
Pago ..> ProcesadorPago : <<use>>
Pago ..> MetodoPago
Pedido ..> EstadoPedido

note bottom of ItemPedido
  Cada ítem referencia un Producto
  o un Combo (exactamente uno de los dos).
  precioUnitario congela el precio histórico.
end note
note as NotaCliente
  Cliente es un actor externo y no una
  clase persistente: no se registra una
  ficha de cliente (RF6).
end note
@enduml